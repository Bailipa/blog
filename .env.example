NODE_ENV=development
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-this-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL=info

# P3: magic-link auth (prod uses Aliyun DirectMail, dev falls through to /tmp/magic-link-debug.log)
DIRECT_MAIL_ACCESS_KEY_ID=
DIRECT_MAIL_ACCESS_KEY_SECRET=
DIRECT_MAIL_FROM=
DIRECT_MAIL_FROM_NAME="LB Blog"
DIRECT_MAIL_REGION="cn-hangzhou"
CREATOR_EMAIL=
ALLOW_PASSWORD_LOGIN="false"
