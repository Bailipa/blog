generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String?  @unique
  password  String?
  email     String?  @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  // P4: public profile fields
  name             String?
  bio              String?
  avatarUrl        String?        // null = use Gravatar fallback
  onboarded        Boolean        @default(false)   // has set username via /onboarding
  emailVerified    DateTime?
  notifyOnReply    Boolean        @default(true)
  notifyOnNewPost  Boolean        @default(false)
  deletedAt        DateTime?      // soft-delete (R2)

  // P5+: paywall foundation (no UI yet, all nullable)
  subscriptionTier       String?    // null | "free" | "paid"
  subscriptionExpiresAt  DateTime?
  purchasedPosts         String?    // JSON array of post ids

  comments  Comment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String
  excerpt     String?
  coverImage  String?
  status      String     @default("DRAFT")
  featured    Boolean    @default(false)
  viewCount   Int        @default(0)
  publishedAt DateTime?

  // P5+: paywall foundation (no UI yet)
  accessTier  String     @default("free")   // "free" | "paid"
  priceCents  Int?                         // optional single-purchase price in cents
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  tags        PostTag[]
  translations PostTranslation[]
  comments    Comment[]

  @@index([status, publishedAt])
}

model PostTranslation {
  id      String @id @default(cuid())
  postId  String
  lang    String
  title   String
  content String
  excerpt String?
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, lang])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?
  sortOrder   Int    @default(0)
  posts       Post[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  longDesc    String?
  url         String
  repoUrl     String?
  coverImage  String?
  techStack   String
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mumble {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
}

model FriendLink {
  id          String @id @default(cuid())
  name        String
  url         String
  description String?
  sortOrder   Int    @default(0)
}

model PageView {
  id    String @id @default(cuid())
  path  String
  date  String
  count Int    @default(0)

  @@unique([path, date])
}

model SiteConfig {
  key   String @id
  value String
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  content   String
  status    String   @default("VISIBLE")
  authorId  String?
  ipHash    String?
  // P4: snapshot of author identity at comment time. Survives username
  // changes and account deletion. authorId stays the live FK.
  authorName   String?
  authorAvatar String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([authorId])
}
