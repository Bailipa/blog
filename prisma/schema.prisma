generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String?  @unique
  password  String?
  email     String?  @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  // P4: public profile fields
  name             String?
  bio              String?
  avatarUrl        String?        // null = use Gravatar fallback
  onboarded        Boolean        @default(false)   // has set username via /onboarding
  emailVerified    DateTime?
  notifyOnReply    Boolean        @default(true)
  notifyOnNewPost  Boolean        @default(false)
  deletedAt        DateTime?      // soft-delete (R2)

  // P5+: paywall foundation (no UI yet, all nullable)
  subscriptionTier       String?    // null | "free" | "paid"
  subscriptionExpiresAt  DateTime?
  purchasedPosts         String?    // JSON array of post ids

  comments  Comment[]
  redeemCodes RedeemCode[]
  mbdOrders  MbdOrder[]
}

// 面包多订单记录（回调落库，用于防重复 + 对账审计）
model MbdOrder {
  id          String   @id @default(cuid())
  orderId     String   @unique
  outOrderId  String?
  userId      String?
  postId      String?
  amountCents Int      @default(0)
  state       String   @default("PAID")
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([postId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  code       String?  @unique       // 6-digit OTP code; null after migration if you never re-issue
  consumed   Boolean  @default(false)  // flipped true when the row is consumed by verify-code
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String
  excerpt     String?
  coverImage  String?
  status      String     @default("DRAFT")
  featured    Boolean    @default(false)
  viewCount   Int        @default(0)
  readingMinutes Int    @default(1)
  publishedAt DateTime?

  // P5+: paywall foundation
  accessTier     String   @default("free")   // "free" | "paid"
  priceCents     Int?                       // optional single-purchase price in cents
  mbdProductUrl  String?                    // 面包多 (mbd.pub) 商品链接，付款后自动发兑换码
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  tags           PostTag[]
  translations   PostTranslation[]
  comments       Comment[]
  redeemCodes    RedeemCode[]

  @@index([status, publishedAt])
}

// 面包多自动发货的兑换码库存。每篇付费文章有若干兑换码；买家在面包多
// 付款后拿到一个码，回到本站 /purchase/redeem 兑换解锁。
model RedeemCode {
  id           String    @id @default(cuid())
  code         String    @unique
  postId       String
  status       String    @default("UNUSED")  // "UNUSED" | "USED"
  redeemedById String?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  redeemedBy   User?     @relation(fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([status])
}

model PostTranslation {
  id      String @id @default(cuid())
  postId  String
  lang    String
  title   String
  content String
  excerpt String?
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, lang])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?
  sortOrder   Int    @default(0)
  posts       Post[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  longDesc    String?
  url         String
  repoUrl     String?
  coverImage  String?
  techStack   String
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mumble {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
}

model FriendLink {
  id          String @id @default(cuid())
  name        String
  url         String
  description String?
  sortOrder   Int    @default(0)
}

model PageView {
  id    String @id @default(cuid())
  path  String
  date  String
  count Int    @default(0)

  @@unique([path, date])
}

model SiteConfig {
  key   String @id
  value String
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  content   String
  status    String   @default("VISIBLE")
  authorId  String?
  ipHash    String?
  // P4: snapshot of author identity at comment time. Survives username
  // changes and account deletion. authorId stays the live FK.
  authorName   String?
  authorAvatar String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([authorId])
}
